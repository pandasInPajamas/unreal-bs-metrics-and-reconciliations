model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataRoot","fnLoadCsv","dim_date","dim_customer","dim_gl_account","dim_recon_check","dim_root_cause","dim_walk_step","fact_arr_snapshot","fact_arr_movement","fact_gl_line","fact_recon_daily","fact_recon_monthly","fact_recon_exception","fact_correcting_entry","fact_walk_line","bridge_recon_month_root_cause","bridge_root_cause_check"]

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop"]

ref table dim_date
ref table dim_customer
ref table dim_gl_account
ref table dim_recon_check
ref table dim_root_cause
ref table dim_walk_step
ref table fact_arr_snapshot
ref table fact_arr_movement
ref table fact_gl_line
ref table fact_recon_daily
ref table fact_recon_monthly
ref table fact_recon_exception
ref table fact_correcting_entry
ref table fact_walk_line
ref table bridge_recon_month_root_cause
ref table bridge_root_cause_check

ref cultureInfo en-US

