	measure 'FX ARR' = SUM ( fact_arr_movement[fx_usd] )
		lineageTag: 7c192036-ea53-4285-a439-b1f6ded04465

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'FX (display)' = [FX ARR] * [Period Scale]
		lineageTag: 626a6f59-fa58-4842-9db7-1a666fdfe45b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Bridge Value' =
			
			VAR s = SELECTEDVALUE ( 'Bridge Steps'[Step] )
			VAR v =
			    SWITCH ( s,
			        "New", [New (display)],
			        "Expansion", [Expansion (display)],
			        "Reactivation", [Reactivation (display)],
			        "Contraction", [Contraction (display)],
			        "Churn", [Churn (display)],
			        "FX", [FX (display)]
			    )
			RETURN IF ( v = 0, BLANK (), v )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 140b0e55-70cf-4c64-ad18-62ae69cf34d1

	measure 'Customers Gained' = [New Customers] + [Reactivated Customers]
		formatString: 0
		lineageTag: a5851a11-b34b-4b29-a70c-716e246d83aa

	measure 'Customers Lost' = - [Churned Customers]
		formatString: 0
		lineageTag: 3118ce33-0ec6-45ac-b259-c13e4591247e

	measure 'Net Customers' = [Customers Gained] + [Customers Lost]
		formatString: 0
		lineageTag: ad7c3eb0-5f5a-46e7-9b50-3d4330e881fd

	measure 'Quick Ratio 3M' =
			
			VAR Win = DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -3, MONTH )
			RETURN
			    DIVIDE (
			        CALCULATE ( [New ARR] + [Expansion ARR] + [Reactivation ARR], Win ),
			        - CALCULATE ( [Contraction ARR] + [Churn ARR], Win )
			    )
		lineageTag: 39401300-5504-46c6-9178-6f3566d20948

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Logo Quick Ratio 3M' =
			
			VAR Win = DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -3, MONTH )
			RETURN
			    DIVIDE (
			        CALCULATE ( [New Customers] + [Reactivated Customers], Win ),
			        CALCULATE ( [Churned Customers], Win )
			    )
		lineageTag: 55853c81-84fa-48af-b234-1fab799a0b5f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MRR Sparkline' =
			
			VAR EndM = MAX ( dim_date[month_start] )
			VAR Pts =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( dim_date[month_start] ),
			            REMOVEFILTERS ( dim_date ),
			            dim_date[month_start] > EDATE ( EndM, -12 ),
			            dim_date[month_start] <= EndM
			        ),
			        "@v",
			            VAR m = dim_date[month_start]
			            RETURN CALCULATE ( [MRR], REMOVEFILTERS ( dim_date ), dim_date[month_start] = m )
			    )
			VAR Ranked = ADDCOLUMNS ( Pts, "@i", RANKX ( Pts, dim_date[month_start], , ASC ) - 1 )
			VAR N = COUNTROWS ( Ranked )
			VAR MinV = MINX ( Ranked, [@v] )
			VAR MaxV = MAXX ( Ranked, [@v] )
			VAR W = 120  VAR H = 32  VAR Pad = 3
			VAR Coords =
			    CONCATENATEX (
			        Ranked,
			        FORMAT ( Pad + [@i] * ( W - 2 * Pad ) / MAX ( N - 1, 1 ), "0.0" ) & ","
			            & FORMAT ( H - Pad - DIVIDE ( [@v] - MinV, MaxV - MinV ) * ( H - 2 * Pad ), "0.0" ),
			        " ", dim_date[month_start], ASC
			    )
			VAR LastV = MAXX ( FILTER ( Ranked, dim_date[month_start] = EndM ), [@v] )
			VAR LastY = H - Pad - DIVIDE ( LastV - MinV, MaxV - MinV ) * ( H - 2 * Pad )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & W & " " & H & "'>"
			    & "<polyline fill='none' stroke='%238B8FA3' stroke-width='1.5' stroke-linejoin='round' points='" & Coords & "'/>"
			    & "<circle cx='" & W - Pad & "' cy='" & FORMAT ( LastY, "0.0" ) & "' r='2.5' fill='%232DD4BF'/>"
			    & "</svg>"
		lineageTag: 16732926-e6d9-4954-971e-365356e438e4

	measure 'Run Rate (display)' = [ARR] * [Period Scale]
		lineageTag: 03b7b708-7ea6-48e7-91fd-bc21d7076e61

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Run Rate (MRR/ARR) Sparkline' =
			
			VAR EndM = MAX ( dim_date[month_start] )
			VAR Pts =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( dim_date[month_start] ),
			            REMOVEFILTERS ( dim_date ),
			            dim_date[month_start] > EDATE ( EndM, -12 ),
			            dim_date[month_start] <= EndM
			        ),
			        "@v",
			            VAR m = dim_date[month_start]
			            RETURN CALCULATE ( [Run Rate (display)], REMOVEFILTERS ( dim_date ), dim_date[month_start] = m )
			    )
			VAR Ranked = ADDCOLUMNS ( Pts, "@i", RANKX ( Pts, dim_date[month_start], , ASC ) - 1 )
			VAR N = COUNTROWS ( Ranked )
			VAR MinV = MINX ( Ranked, [@v] )
			VAR MaxV = MAXX ( Ranked, [@v] )
			VAR W = 120
			VAR H = 32
			VAR Pad = 4
			VAR Floor = H * 0.65
			VAR Coords =
			    CONCATENATEX (
			        Ranked,
			        FORMAT ( Pad + [@i] * ( W - 2 * Pad ) / MAX ( N - 1, 1 ), "0.0" ) & ","
			            & FORMAT ( Floor - DIVIDE ( [@v] - MinV, MaxV - MinV ) * ( Floor - Pad ), "0.0" ),
			        " ", dim_date[month_start], ASC
			    )
			VAR Area = Coords & " " & ( W - Pad ) & "," & H & " " & Pad & "," & H
			VAR LastV = MAXX ( FILTER ( Ranked, dim_date[month_start] = EndM ), [@v] )
			VAR LastY = Floor - DIVIDE ( LastV - MinV, MaxV - MinV ) * ( Floor - Pad )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & W & " " & H & "'>"
			    & "<defs><linearGradient id='g' x1='0' y1='0' x2='0' y2='1'>"
			    & "<stop offset='0' stop-color='%2322D3EE' stop-opacity='0.35'/>"
			    & "<stop offset='1' stop-color='%2322D3EE' stop-opacity='0'/>"
			    & "</linearGradient></defs>"
			    & "<polygon fill='url(%23g)' points='" & Area & "'/>"
			    & "<polyline fill='none' stroke='%2322D3EE' stroke-width='1.25' stroke-linejoin='round' points='" & Coords & "'/>"
			    & "<rect x='" & FORMAT ( W - Pad - 1.75, "0.0" ) & "' y='" & FORMAT ( LastY - 1.75, "0.0" ) & "' width='3.5' height='3.5' fill='%23FFFFFF'/>"
			    & "</svg>"
		lineageTag: baef59d3-5e34-4753-ae6a-a8728b329e7c
		dataCategory: ImageUrl

