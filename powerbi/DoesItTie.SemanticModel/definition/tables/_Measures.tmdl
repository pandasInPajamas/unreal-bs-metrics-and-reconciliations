table _Measures
	lineageTag: ac14fbf9-2a02-4cd7-b8ae-6688135a51dc

	measure MRR =
			
			VAR LastSnap = MAX ( fact_arr_snapshot[snapshot_month] )
			RETURN
			    CALCULATE (
			        SUM ( fact_arr_snapshot[mrr_usd] ),
			        REMOVEFILTERS ( dim_date ),
			        fact_arr_snapshot[snapshot_month] = LastSnap
			    )
		formatString: 0
		lineageTag: ebe31fdd-006c-4751-8294-17f37badaa5a

		annotation PBI_FormatHint = {"isDecimal":true}

	measure ARR =
			
			VAR LastSnap = MAX ( fact_arr_snapshot[snapshot_month] )
			RETURN
			    CALCULATE (
			        SUM ( fact_arr_snapshot[arr_usd] ),
			        REMOVEFILTERS ( dim_date ),
			        fact_arr_snapshot[snapshot_month] = LastSnap
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 8f1ad29f-ef0d-449f-9951-22d3c1b84615

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Active Customers' =
			
			VAR LastSnap = MAX ( fact_arr_snapshot[snapshot_month] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( fact_arr_snapshot[customer_id] ),
			        REMOVEFILTERS ( dim_date ),
			        fact_arr_snapshot[snapshot_month] = LastSnap,
			        fact_arr_snapshot[arr_usd] > 0
			    )
		formatString: 0
		lineageTag: 3c5de309-fb8b-40b4-8817-52ec3016b368

	measure 'New ARR' = CALCULATE ( SUM ( fact_arr_movement[movement_usd] ), fact_arr_movement[movement_type] = "New" )
		lineageTag: 11ff4601-c89a-45b3-91d6-1ac70a8e41ed

