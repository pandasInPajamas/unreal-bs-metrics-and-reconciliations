	measure 'Quick Ratio' =
			
			DIVIDE (
			    [New ARR] + [Expansion ARR] + [Reactivation ARR],
			    - ( [Contraction ARR] + [Churn ARR] )
			)
		lineageTag: bd0bc44a-0701-467a-8240-a1bb0d9b9a50

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Logo Quick Ratio' =
			
			DIVIDE (
			    [New Customers] + [Reactivated Customers],
			    [Churned Customers]
			)
		lineageTag: 9e1bcddb-79cd-42cb-b489-8090c40589d7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Period Scale' =
			
			VAR Sel = SELECTEDVALUE ( 'MRR/ARR'[MRR/ARR Order], 1 )   -- default: ARR
			RETURN IF ( Sel = 0, 1 / 12, 1 )
		lineageTag: a2f3ba34-9f47-475d-bffe-be84afa78deb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'New (display)' = [New ARR] * [Period Scale]
		lineageTag: 23d3896f-63c9-42fc-946f-0b6d36bc8d36

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Expansion (display)' = [Expansion ARR] * [Period Scale]
		lineageTag: 380f26b9-037a-4c2e-8a11-62ab2b2d5aa6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Reactivation (display)' = [Reactivation ARR] * [Period Scale]
		lineageTag: 91a5fe04-ec70-4aa3-b68a-2ac49f6dd532

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Contraction (display)' = ```
			[Contraction ARR] * [Period Scale]  
			```
		lineageTag: cdf49ded-71e3-439a-864c-c9843e7817c6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Churn (display)' = ```
			[Churn ARR] * [Period Scale]    
